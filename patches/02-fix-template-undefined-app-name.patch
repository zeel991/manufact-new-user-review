From 3b4dd2bfb516c1538eab9a25b8837eb2fb25f722 Mon Sep 17 00:00:00 2001
From: zeel991 <darjizeel587@gmail.com>
Date: Tue, 20 Oct 2026 01:03:20 +0530
Subject: [PATCH] fix(create-mcp-use-app): starter message no longer says
 "undefined"

Running show-app without appName returned "The MCP App starter for
undefined is ready!", and the MCP Apps quickstart documented that
instead of the getting-started quickstart's "my project" fallback.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 docs/v2/typescript/mcp-apps/quickstart.mdx                  | 6 ++++--
 .../typescript/.changeset/template-app-name-fallback.md     | 5 +++++
 .../create-mcp-use-app/src/templates/mcp-apps/index.ts      | 4 +++-
 3 files changed, 12 insertions(+), 3 deletions(-)
 create mode 100644 libraries/typescript/.changeset/template-app-name-fallback.md

diff --git a/docs/v2/typescript/mcp-apps/quickstart.mdx b/docs/v2/typescript/mcp-apps/quickstart.mdx
index da433a2..c69e8b3 100644
--- a/docs/v2/typescript/mcp-apps/quickstart.mdx
+++ b/docs/v2/typescript/mcp-apps/quickstart.mdx
@@ -112,7 +112,9 @@ export const showApp = server.tool(
     await new Promise((resolve) => setTimeout(resolve, 1500));
 
     console.log(`The app name was: ${appName}`);
-    const data = { message: `The MCP App starter for ${appName} is ready!` };
+    const data = {
+      message: `The MCP App starter for ${appName ?? "my project"} is ready!`,
+    };
 
     return {
       content: [{ type: "text", text: data.message }],
@@ -207,7 +209,7 @@ Use the Inspector to confirm that the server and view work.
 1. Open `http://localhost:3000/mcp/inspector`.
 2. Go to the **Tools** tab.
 3. Select `show-app`.
-4. Run the tool with `{ "appName": "My App" }`. Without `appName`, the result message contains `undefined`.
+4. Run the tool with `{ "appName": "My App" }`.
 5. Confirm that the view renders below the tool result and its heading shows "My App". The handler waits 1.5 seconds, so the view can show a loading skeleton first.
 6. Select **Say Hello** in the view. Confirm that it shows `Tool Response: Hello, mcp-use!`.
 
diff --git a/libraries/typescript/.changeset/template-app-name-fallback.md b/libraries/typescript/.changeset/template-app-name-fallback.md
new file mode 100644
index 0000000..7f352a8
--- /dev/null
+++ b/libraries/typescript/.changeset/template-app-name-fallback.md
@@ -0,0 +1,5 @@
+---
+"create-mcp-use-app": patch
+---
+
+The `mcp-apps` template's `show-app` message no longer reads "The MCP App starter for undefined is ready!" when `appName` is omitted; it falls back to "my project", matching the getting-started quickstart.
diff --git a/libraries/typescript/packages/create-mcp-use-app/src/templates/mcp-apps/index.ts b/libraries/typescript/packages/create-mcp-use-app/src/templates/mcp-apps/index.ts
index 9333e40..b4ea182 100644
--- a/libraries/typescript/packages/create-mcp-use-app/src/templates/mcp-apps/index.ts
+++ b/libraries/typescript/packages/create-mcp-use-app/src/templates/mcp-apps/index.ts
@@ -74,7 +74,9 @@ export const showApp = server.tool(
     await new Promise((resolve) => setTimeout(resolve, 1500));
 
     console.log(`The app name was: ${appName}`);
-    const data = { message: `The MCP App starter for ${appName} is ready!` };
+    const data = {
+      message: `The MCP App starter for ${appName ?? "my project"} is ready!`,
+    };
 
     return {
       content: [{ type: "text", text: data.message }],
-- 
